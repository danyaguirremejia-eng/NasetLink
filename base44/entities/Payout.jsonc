{
  "name": "Payout",
  "type": "object",
  "properties": {
    "amount": {
      "type": "number",
      "description": "Monto solicitado en USD."
    },
    "paypal_email": {
      "type": "string",
      "description": "Correo de PayPal donde se env\u00eda el pago."
    },
    "user_email": {
      "type": "string",
      "description": "Correo del usuario que solicita el pago."
    },
    "status": {
      "type": "string",
      "description": "Estado de la solicitud de pago.",
      "enum": [
        "pending",
        "processing",
        "paid",
        "rejected"
      ],
      "enumColors": [
        "yellow",
        "blue",
        "green",
        "red"
      ],
      "default": "pending"
    },
    "requested_at": {
      "type": "string",
      "description": "Fecha de la solicitud en formato ISO."
    }
  },
  "required": [
    "amount",
    "paypal_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}